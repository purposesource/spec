{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://purposesource.org/spec/schemas/sponsorship-schedule.v1.json",
  "title": "Sponsorship schedule — /sponsors/schedule/{version}.json",
  "description": "The published tiers and terms of sponsorship of the Purpose Source Association (ops decision D44). Sponsorship is invoiced and paid by bank transfer into the Association's general account; it is never a Purpose Fee, never sold at checkout or through the payment provider, buys no coverage, no licence credential and no influence, and is used in one published order: the Purpose Source activity's running costs as named cost support (statutes Art. 6b), then the operations reserve up to its target (Art. 6g(2)), then the Association's general costs (Art. 6d). Every sponsor is named (Art. 6b(3)).\n\nA SCHEDULE IS VERSIONED, NEVER EDITED IN PLACE once a sponsor has paid under it (the D32 note's reliance rule): new tiers are a new version at a new permalink, and each sponsor record names the version it paid under.",
  "x-psn": {
    "specVersion": "1.0.0",
    "phase": "P-M2",
    "artifactPath": "/sponsors/schedule/{version}.json",
    "authoritative": true,
    "producer": "authored on the website as src/content/sponsorship/v{n}.json and served at its permalink (P-M2); the board adopts it under its sponsoring policy",
    "consumers": [
      "the /sponsors page",
      "the invoice the Association issues",
      "the tax adviser and counsel reviewing its VAT and direct-tax character"
    ],
    "fsRefs": [
      "statutes Art. 3(6)(5)",
      "Art. 6b",
      "Art. 6d",
      "Art. 6g",
      "GOV-008",
      "COM-070",
      "LEG-094",
      "OPEN-41",
      "D44"
    ],
    "vsRefs": [],
    "changelog": "CHANGELOG.md#sponsorship-schedulev1json"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "permalink",
    "status",
    "adoptedAt",
    "currency",
    "periodMonths",
    "tiers",
    "useOrder",
    "rules"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "permalink": {
      "type": "string",
      "pattern": "^/sponsors/schedule/v[0-9]+$"
    },
    "status": {
      "enum": [
        "draft",
        "adopted"
      ],
      "description": "`draft` until the board adopts its sponsoring policy and the tax adviser has answered on the VAT character (LEG-094); no invoice is issued under a draft."
    },
    "adoptedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "periodMonths": {
      "type": "integer",
      "minimum": 1,
      "maximum": 24,
      "description": "A sponsorship period runs this many calendar months from the first day of the month after the payment settles."
    },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "amountMinor"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^t[0-9]$"
          },
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 40,
            "description": "A neutral name. Tier names never rank generosity."
          },
          "amountMinor": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "The fixed amount for one period, the same for everyone. No other amount is invoiced."
          }
        }
      }
    },
    "useOrder": {
      "const": [
        "cost-support",
        "operations-reserve",
        "general-costs"
      ]
    },
    "rules": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,40}$"
          },
          "text": {
            "type": "string",
            "minLength": 20
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "id": {
                "const": "invoice-only"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "general-account"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "use-order"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "named"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "no-influence"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "no-coverage"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "not-at-checkout"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "screening"
              }
            },
            "required": [
              "id"
            ]
          }
        }
      ]
    }
  }
}
