          "handle": "^(?!.*\\.(?:git|atom)$)[A-Za-z0-9_](?:[A-Za-z0-9_]|[.-](?=[A-Za-z0-9_])){0,63}$",
          "bare": true,
          "output": "https://gitlab.com/{h}"
        }
      ]
    },
