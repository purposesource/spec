{
  "schemaVersion": 1,
  "_comment": [
    "The pinned link table of the contributor page (ops decision D116 item 1 and its dated notes of 2026-10-06; design PROFILE-PAGE-2026-10-06 §5). Published once, here; the platform and the website edge vendor it byte for byte and pin its SHA-256.",
    "A person picks a platform and pastes a full https address, a domain and path, or just the username. Only {platform, form, handle, instance} is kept, and every address shown is rebuilt from `output` below: loose input, strict output. Nothing here is ever fetched.",
    "The steps that read this table are described in schemas/link-platforms.v1.json; examples/link-rules.v1.golden.json holds the shared cases every implementation runs. A changed answer is a data change with a golden case, reviewed by a steward."
  ],
  "pipeline": {
    "inputMaxLength": 300,
    "outputMaxLength": 300,
    "refusedSchemes": [
      "about",
      "blob",
      "chrome",
      "data",
      "file",
      "filesystem",
      "ftp",
      "intent",
      "jar",
      "javascript",
      "mailto",
      "sms",
      "tel",
      "vbscript",
      "view-source",
      "ws",
      "wss"
    ],
    "urlCharacters": "^[A-Za-z0-9._~:/?#\\[\\]@!$&'()*+,;=%-]+$",
    "outputPattern": "^https://[a-z0-9.-]+/[A-Za-z0-9._@:/?=#+-]*$"
  },
  "refusedTlds": ["alt", "arpa", "example", "internal", "invalid", "lan", "local", "localhost", "onion", "test"],
  "platforms": [
    {
      "id": "github",
      "kind": "verified",
      "label": "GitHub",
      "verified": true,
      "typed": false,
      "provisional": false,
      "forms": [
        {
          "id": "profile",
          "handle": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$",
          "bare": false,
          "output": "https://github.com/{h}"
        }
      ]
    },
    {
      "id": "gitlab",
