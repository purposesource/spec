        "login": "sam-codes",
        "showLogin": false,
        "repositories": {
          "mode": "all",
          "hidden": [
            "R_kgDOSMPL0023"
          ],
          "years": true
        },
        "credited": [
          {
            "nodeId": "R_kgDOSMPL0021",
